// Version Information
VS_VERSION_INFO VERSIONINFO
FILEVERSION 3,0,0,0
PRODUCTVERSION 3,0,0,0
FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
FILEFLAGS 0x1L
#else
FILEFLAGS 0x0L
#endif
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "PDF Elite Contributors"
            VALUE "FileDescription", "PDF Elite Native Viewer and Editor"
            VALUE "FileVersion", "3.0.0.0"
            VALUE "InternalName", "PDFElite"
            VALUE "LegalCopyright", "Copyright (C) 2026 PDF Elite Contributors"
            VALUE "OriginalFilename", "PDFElite.exe"
            VALUE "ProductName", "PDF Elite"
            VALUE "ProductVersion", "3.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// ============================================================================
// Task 14: Link Annotation Dialog
// ============================================================================
IDD_LINK_DIALOG DIALOGEX 0, 0, 270, 160
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Create Link Annotation"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Destination",IDC_STATIC,7,7,256,76
    AUTORADIOBUTTON "Open Web URL",IDC_LINK_TYPE_URL,15,20,100,10,WS_GROUP
    EDITTEXT        IDC_LINK_URL_EDIT,27,33,228,14,ES_AUTOHSCROLL
    AUTORADIOBUTTON "Go to Page in Document",IDC_LINK_TYPE_PAGE,15,52,110,10
    LTEXT           "Page number:",IDC_STATIC,27,65,50,8
    EDITTEXT        IDC_LINK_PAGE_EDIT,82,63,40,14,ES_NUMBER | ES_AUTOHSCROLL
    CONTROL         "",IDC_LINK_PAGE_SPIN,"msctls_updown32",UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS,122,63,11,14

    GROUPBOX        "Appearance",IDC_STATIC,7,88,256,42
    AUTOCHECKBOX    "Draw visible border rectangle",IDC_LINK_BORDER_CHECK,15,102,120,10
    PUSHBUTTON      "Border Color...",IDC_LINK_COLOR_BTN,150,100,70,14

    DEFPUSHBUTTON   "OK",IDOK,157,138,50,15
    PUSHBUTTON      "Cancel",IDCANCEL,213,138,50,15
END

// ============================================================================
// Task 15: Document Background Dialog
// ============================================================================
IDD_BACKGROUND_DIALOG DIALOGEX 0, 0, 300, 210
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Add Background"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Background Source",IDC_STATIC,7,7,286,80
    AUTORADIOBUTTON "Solid Color",IDC_BG_TYPE_COLOR,15,20,60,10,WS_GROUP
    PUSHBUTTON      "Choose Color...",IDC_BG_COLOR_BTN,85,18,70,14
    CONTROL         "",IDC_BG_COLOR_PREVIEW,"Static",SS_BLACKFRAME | SS_SUNKEN,165,18,30,14
    AUTORADIOBUTTON "Image File",IDC_BG_TYPE_IMAGE,15,42,60,10
    EDITTEXT        IDC_BG_IMAGE_PATH_EDIT,27,55,205,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...",IDC_BG_IMAGE_BROWSE_BTN,237,55,50,14

    GROUPBOX        "Appearance",IDC_STATIC,7,92,286,45
    LTEXT           "Opacity:",IDC_STATIC,15,110,32,8
    CONTROL         "",IDC_BG_OPACITY_SLIDER,"msctls_trackbar32",TBS_AUTOTICKS | WS_TABSTOP,50,105,185,20
    EDITTEXT        IDC_BG_OPACITY_EDIT,240,107,35,14,ES_CENTER | ES_READONLY

    GROUPBOX        "Page Range",IDC_STATIC,7,142,286,40
    AUTORADIOBUTTON "All Pages",IDC_BG_PAGE_ALL,15,158,50,10,WS_GROUP
    AUTORADIOBUTTON "Current Page",IDC_BG_PAGE_CURRENT,75,158,60,10
    AUTORADIOBUTTON "Pages:",IDC_BG_PAGE_RANGE,145,158,40,10
    EDITTEXT        IDC_BG_RANGE_EDIT,190,156,85,14,ES_AUTOHSCROLL

    DEFPUSHBUTTON   "Apply",IDOK,187,188,50,15
    PUSHBUTTON      "Cancel",IDCANCEL,243,188,50,15
END

// ============================================================================
// Task 16: Watermark Dialog
// ============================================================================
IDD_WATERMARK_DIALOG DIALOGEX 0, 0, 310, 245
