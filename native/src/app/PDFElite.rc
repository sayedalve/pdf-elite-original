// ============================================================================
// Task 20: Combine PDF Dialog
// ============================================================================
IDD_COMBINE_PDF_DIALOG DIALOGEX 0, 0, 360, 250
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Combine PDF Documents"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Source PDF Documents to Merge",IDC_STATIC,7,7,346,145
    CONTROL         "",IDC_COMBINE_FILE_LIST,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,15,20,250,122
    PUSHBUTTON      "Add Files...",IDC_COMBINE_ADD_BTN,272,20,72,14
    PUSHBUTTON      "Remove",IDC_COMBINE_REMOVE_BTN,272,38,72,14
    PUSHBUTTON      "Move Up",IDC_COMBINE_MOVE_UP_BTN,272,56,72,14
    PUSHBUTTON      "Move Down",IDC_COMBINE_MOVE_DOWN_BTN,272,74,72,14
    PUSHBUTTON      "Clear All",IDC_COMBINE_CLEAR_BTN,272,92,72,14

    GROUPBOX        "Output Destination",IDC_STATIC,7,156,346,58
    LTEXT           "Save As:",IDC_STATIC,15,172,35,8
    EDITTEXT        IDC_COMBINE_OUTPUT_EDIT,55,170,225,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...",IDC_COMBINE_OUTPUT_BROWSE,285,170,60,14
    AUTOCHECKBOX    "Open combined document after merging",IDC_COMBINE_OPEN_CHECK,15,192,180,10

    DEFPUSHBUTTON   "Combine & Save",IDOK,235,225,60,15
    PUSHBUTTON      "Cancel",IDCANCEL,300,225,50,15
END
