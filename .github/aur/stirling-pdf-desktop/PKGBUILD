# Maintainer: PDF Elite Inc <contact@PDFElitepdf.com>
pkgname=pdf-elite-desktop
pkgver=2.14.2
pkgrel=1
pkgdesc="Locally hosted, web-based PDF manipulation tool (Tauri desktop app, official PDF Elite Inc build)"
arch=('x86_64')
url="https://www.PDFElite.com"
license=('MIT' 'LicenseRef-pdf-elite-Proprietary')
depends=('gtk3' 'webkit2gtk-4.1' 'libappindicator-gtk3')
provides=('pdf-elite')
conflicts=('pdf-elite' 'pdf-elite-git' 'pdf-elite-bin')
options=('!strip')

source_x86_64=("${pkgname}-${pkgver}.deb::https://github.com/PDFElite-Tools/pdf-elite/releases/download/v${pkgver}/pdf-elite-linux-x86_64.deb")
sha256sums_x86_64=('PLACEHOLDER_DEB_SHA256')

package() {
    # Extract the .deb archive
    bsdtar -xf data.tar* -C "${pkgdir}"

    # Fix permissions
    find "${pkgdir}" -type d -exec chmod 755 {} \;

    # Install license
    install -Dm644 /dev/stdin "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE" <<EOF
Copyright (c) 2025 PDF Elite Inc
All rights reserved. See https://github.com/PDFElite-Tools/pdf-elite/blob/main/LICENSE
EOF
}
