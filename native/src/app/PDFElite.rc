    CONTROL         "",IDC_WM_OPACITY_SLIDER,"msctls_trackbar32",TBS_AUTOTICKS | WS_TABSTOP,50,88,195,20
    EDITTEXT        IDC_WM_OPACITY_EDIT,250,90,35,14,ES_CENTER | ES_READONLY
    LTEXT           "Rotation:",IDC_STATIC,15,115,32,8
    COMBOBOX        IDC_WM_ROT_COMBO,50,113,75,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        IDC_WM_ROT_EDIT,130,113,30,14,ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "Position:",IDC_STATIC,175,115,30,8
    COMBOBOX        IDC_WM_POS_COMBO,210,113,83,70,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTORADIOBUTTON "Over Page Content",IDC_WM_LAYER_OVER,50,138,85,10,WS_GROUP
    AUTORADIOBUTTON "Under Content (Background)",IDC_WM_LAYER_UNDER,145,138,120,10

    GROUPBOX        "Page Range",IDC_STATIC,7,164,296,48
    AUTORADIOBUTTON "All Pages",IDC_WM_PAGE_ALL,15,180,50,10,WS_GROUP
    AUTORADIOBUTTON "Current Page",IDC_WM_PAGE_CURRENT,75,180,60,10
    AUTORADIOBUTTON "Pages:",IDC_WM_PAGE_RANGE,145,180,40,10
    EDITTEXT        IDC_WM_RANGE_EDIT,190,178,95,14,ES_AUTOHSCROLL

    DEFPUSHBUTTON   "Apply",IDOK,197,222,50,15
    PUSHBUTTON      "Cancel",IDCANCEL,253,222,50,15
END

// ============================================================================
// Task 17: Header & Footer Dialog
// ============================================================================
IDD_HEADER_FOOTER_DIALOG DIALOGEX 0, 0, 340, 290
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Add Header & Footer"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Header (Top of Page)",IDC_STATIC,7,7,326,52
    LTEXT           "Left:",IDC_STATIC,15,20,20,8
    EDITTEXT        IDC_HF_TOP_LEFT_EDIT,38,18,65,14,ES_AUTOHSCROLL
    LTEXT           "Center:",IDC_STATIC,110,20,26,8
    EDITTEXT        IDC_HF_TOP_CENTER_EDIT,140,18,75,14,ES_AUTOHSCROLL
    LTEXT           "Right:",IDC_STATIC,222,20,22,8
    EDITTEXT        IDC_HF_TOP_RIGHT_EDIT,248,18,75,14,ES_AUTOHSCROLL

    GROUPBOX        "Footer (Bottom of Page)",IDC_STATIC,7,62,326,52
    LTEXT           "Left:",IDC_STATIC,15,75,20,8
    EDITTEXT        IDC_HF_BOTTOM_LEFT_EDIT,38,73,65,14,ES_AUTOHSCROLL
    LTEXT           "Center:",IDC_STATIC,110,75,26,8
    EDITTEXT        IDC_HF_BOTTOM_CENTER_EDIT,140,73,75,14,ES_AUTOHSCROLL
    LTEXT           "Right:",IDC_STATIC,222,75,22,8
    EDITTEXT        IDC_HF_BOTTOM_RIGHT_EDIT,248,73,75,14,ES_AUTOHSCROLL

    GROUPBOX        "Insert Macro Tokens",IDC_STATIC,7,118,326,35
    PUSHBUTTON      "Insert Page Number",IDC_HF_MACRO_PAGE_NUM,15,130,85,15
    PUSHBUTTON      "Insert Page Count",IDC_HF_MACRO_PAGE_COUNT,110,130,85,15
    PUSHBUTTON      "Insert Date",IDC_HF_MACRO_DATE,205,130,70,15

    GROUPBOX        "Font & Margins (Points)",IDC_STATIC,7,157,326,52
    LTEXT           "Font:",IDC_STATIC,15,170,20,8
    COMBOBOX        IDC_HF_FONT_COMBO,40,168,75,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Size:",IDC_STATIC,125,170,20,8
    EDITTEXT        IDC_HF_SIZE_EDIT,150,168,25,14,ES_NUMBER | ES_AUTOHSCROLL
    PUSHBUTTON      "Color...",IDC_HF_COLOR_BTN,185,168,45,14
    LTEXT           "Top:",IDC_STATIC,15,190,18,8
    EDITTEXT        IDC_HF_MARGIN_TOP_EDIT,38,188,25,14,ES_NUMBER
    LTEXT           "Bot:",IDC_STATIC,72,190,16,8
    EDITTEXT        IDC_HF_MARGIN_BOTTOM_EDIT,92,188,25,14,ES_NUMBER
    LTEXT           "Left:",IDC_STATIC,125,190,18,8
    EDITTEXT        IDC_HF_MARGIN_LEFT_EDIT,148,188,25,14,ES_NUMBER
    LTEXT           "Right:",IDC_STATIC,180,190,22,8
    EDITTEXT        IDC_HF_MARGIN_RIGHT_EDIT,205,188,25,14,ES_NUMBER

    GROUPBOX        "Page Range",IDC_STATIC,7,213,326,42
    AUTORADIOBUTTON "All Pages",IDC_HF_PAGE_ALL,15,229,50,10,WS_GROUP
    AUTORADIOBUTTON "Pages:",IDC_HF_PAGE_RANGE,75,229,40,10
    EDITTEXT        IDC_HF_RANGE_EDIT,120,227,95,14,ES_AUTOHSCROLL

    DEFPUSHBUTTON   "Apply",IDOK,227,265,50,15
    PUSHBUTTON      "Cancel",IDCANCEL,283,265,50,15
END

// ============================================================================
// Task 18: Create Blank PDF Dialog
// ============================================================================
IDD_CREATE_BLANK_DIALOG DIALOGEX 0, 0, 280, 200
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Create Blank PDF"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Page Specifications",IDC_STATIC,7,7,266,65
    LTEXT           "Page Size:",IDC_STATIC,15,20,38,8
    COMBOBOX        IDC_BLANK_SIZE_COMBO,60,18,85,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Width:",IDC_STATIC,15,38,25,8
    EDITTEXT        IDC_BLANK_WIDTH_EDIT,60,36,45,14,ES_AUTOHSCROLL
    LTEXT           "Height:",IDC_STATIC,115,38,28,8
    EDITTEXT        IDC_BLANK_HEIGHT_EDIT,148,36,45,14,ES_AUTOHSCROLL
    LTEXT           "Units:",IDC_STATIC,200,38,22,8
    COMBOBOX        IDC_BLANK_UNIT_COMBO,225,36,40,50,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTORADIOBUTTON "Portrait",IDC_BLANK_PORTRAIT_RADIO,60,54,50,10,WS_GROUP
    AUTORADIOBUTTON "Landscape",IDC_BLANK_LANDSCAPE_RADIO,120,54,55,10

    GROUPBOX        "Document Configuration",IDC_STATIC,7,76,266,80
    LTEXT           "Page Count:",IDC_STATIC,15,92,45,8
    EDITTEXT        IDC_BLANK_PAGE_COUNT_EDIT,65,90,40,14,ES_NUMBER | ES_AUTOHSCROLL
    CONTROL         "",IDC_BLANK_COUNT_SPIN,"msctls_updown32",UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS,105,90,11,14
    LTEXT           "Initial Output File (Optional):",IDC_STATIC,15,112,120,8
    EDITTEXT        IDC_BLANK_OUTPUT_EDIT,15,124,190,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...",IDC_BLANK_OUTPUT_BROWSE,210,124,55,14

    DEFPUSHBUTTON   "Create",IDOK,167,175,50,15
    PUSHBUTTON      "Cancel",IDCANCEL,223,175,50,15
END

